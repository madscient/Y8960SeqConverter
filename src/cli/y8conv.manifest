<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process code page is UTF-8, so argv, the narrow file paths and what is
     written out are all in the encoding the rest of the tool uses. Windows 10 1903
     and later honour this; older ones keep the ANSI code page. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
